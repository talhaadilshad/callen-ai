# Callen.ai environment variables.
# Copy to .env.local for local dev, and set the same names in Vercel
# (Project -> Settings -> Environment Variables). Never commit real values.

# --- Supabase (Project Settings -> API keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS: webhooks, provisioning, rate limits.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Public URL; Retell webhook URLs are built from it.
NEXT_PUBLIC_SITE_URL=https://callen-ai-pi.vercel.app

# --- Retell (English agents). Dashboard -> API Keys ---
RETELL_API_KEY=
# Optional: only if RETELL_API_KEY lacks the "webhook" badge.
RETELL_WEBHOOK_API_KEY=

# --- Uplift AI (runs every Urdu call). uplift portal -> Developer (sk_api_...) ---
UPLIFT_API_KEY=

# --- Soniox (voice previews only: /api/voices/:voice/preview). Soniox console -> API keys.
# Calls don't need it: Uplift speaks with Soniox voices on its own account.
SONIOX_API_KEY=
