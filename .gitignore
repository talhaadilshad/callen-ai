# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project-local
screenshots/
dev.log
dev.err.log

# runtime + scratch
dev.run.log
.frames/

# claude-code launch config (local-only)
.claude/

# agent skills runtime artifacts — reinstall via `npx skills add` from skills-lock.json
.agents/

prod.run.log
